# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use
# gemini-2.5-flash was requested in the original spec but is no longer
# available to new API keys/projects as of mid-2026; gemini-flash-latest is
# Google's auto-updating alias for the current recommended fast/cheap model.
GEMINI_MODEL=gemini-flash-latest

# Optional: comma-separated list of allowed CORS origins (frontend URL(s))
# e.g. https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional: rate limit for POST /api/summarize, e.g. "5/minute"
RATE_LIMIT=5/minute

# Optional: cache TTL (seconds) and max entries for in-memory result cache
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=500
